<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
</head>

<body>
  <h1><%= title %></h1>

  <ul>
    <% messages.forEach((m, i) => { %>
    <li>
      <div><%= m.author %></div>
      <div><%= m.text %></div>
      <div><%= m.added.toLocaleString() %></div>
      <a href=<%= `./message-${i}` %>>Open <%= i %></a>
    </li>
    <br>
    <% }) %>
  </ul>
</body>

</html>